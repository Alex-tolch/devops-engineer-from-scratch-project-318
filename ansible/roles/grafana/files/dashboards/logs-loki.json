{
  "annotations": { "list": [] },
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 1,
  "links": [],
  "panels": [
    {
      "datasource": { "type": "loki", "uid": "loki" },
      "gridPos": { "h": 8, "w": 24, "x": 0, "y": 0 },
      "id": 1,
      "options": { "dedupStrategy": "none", "enableLogDetails": true, "showLabels": true, "showTime": true, "sortOrder": "Descending" },
      "targets": [
        {
          "expr": "{job=~\"$job\", app=\"$app\", env=\"$env\", host=~\"$host\"} |= \"$search\"",
          "refId": "A"
        }
      ],
      "title": "Log stream",
      "type": "logs"
    },
    {
      "datasource": { "type": "loki", "uid": "loki" },
      "fieldConfig": { "defaults": { "unit": "short" }, "overrides": [] },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 8 },
      "id": 2,
      "targets": [
        {
          "expr": "sum by (status) (count_over_time({job=\"nginx-metrics\"} | json | status >= 500 [$__interval]))",
          "legendFormat": "HTTP {{status}}",
          "refId": "A"
        }
      ],
      "title": "Nginx 5xx (from access JSON)",
      "type": "timeseries"
    },
    {
      "datasource": { "type": "loki", "uid": "loki" },
      "fieldConfig": { "defaults": { "unit": "s" }, "overrides": [] },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 8 },
      "id": 3,
      "targets": [
        {
          "expr": "quantile_over_time(0.95, {job=\"nginx-metrics\"} | json | unwrap request_time [$__interval]) by (host)",
          "legendFormat": "p95 {{host}}",
          "refId": "A"
        }
      ],
      "title": "Nginx request_time p95",
      "type": "timeseries"
    },
    {
      "datasource": { "type": "loki", "uid": "loki" },
      "fieldConfig": { "defaults": { "unit": "short" }, "overrides": [] },
      "gridPos": { "h": 7, "w": 24, "x": 0, "y": 16 },
      "id": 4,
      "targets": [
        {
          "expr": "sum by (level) (count_over_time({job=\"bulletins-app\"} | json | level != \"\" [$__interval]))",
          "legendFormat": "{{level}}",
          "refId": "A"
        }
      ],
      "title": "Application log volume by level",
      "type": "timeseries"
    }
  ],
  "schemaVersion": 39,
  "tags": ["bulletins", "logs", "loki"],
  "templating": {
    "list": [
      {
        "current": { "selected": true, "text": "All", "value": "$__all" },
        "datasource": { "type": "loki", "uid": "loki" },
        "definition": "label_values(job)",
        "includeAll": true,
        "label": "job",
        "multi": true,
        "name": "job",
        "query": "label_values(job)",
        "refresh": 1,
        "type": "query"
      },
      {
        "current": { "selected": true, "text": "bulletins", "value": "bulletins" },
        "datasource": { "type": "loki", "uid": "loki" },
        "definition": "label_values(app)",
        "label": "app",
        "name": "app",
        "query": "label_values(app)",
        "refresh": 1,
        "type": "query"
      },
      {
        "current": { "selected": true, "text": "prod", "value": "prod" },
        "datasource": { "type": "loki", "uid": "loki" },
        "definition": "label_values(env)",
        "label": "env",
        "name": "env",
        "query": "label_values(env)",
        "refresh": 1,
        "type": "query"
      },
      {
        "current": { "selected": true, "text": "All", "value": "$__all" },
        "datasource": { "type": "loki", "uid": "loki" },
        "definition": "label_values(host)",
        "includeAll": true,
        "label": "host",
        "multi": true,
        "name": "host",
        "query": "label_values(host)",
        "refresh": 1,
        "type": "query"
      },
      {
        "current": { "selected": true, "text": "", "value": "" },
        "label": "Search / client IP",
        "name": "search",
        "options": [{ "selected": true, "text": "", "value": "" }],
        "query": "",
        "type": "textbox"
      }
    ]
  },
  "time": { "from": "now-1h", "to": "now" },
  "timezone": "browser",
  "title": "Logs (Loki)",
  "uid": "bulletins-logs",
  "version": 1
}
