  "panels": [
    {
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 0 },
      "id": 10,
      "title": "Application (Spring Actuator via Nginx)",
      "type": "row"
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "reqps" }, "overrides": [] },
      "gridPos": { "h": 9, "w": 12, "x": 0, "y": 1 },
      "id": 1,
      "targets": [
        {
          "expr": "sum by (status) (rate(http_server_requests_seconds_count{job=\"$job\", instance=\"$instance\"}[5m]))",
          "legendFormat": "HTTP {{status}}",
          "refId": "A"
        }
      ],
      "title": "HTTP request rate by status (application)",
      "type": "timeseries"
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "s" }, "overrides": [] },
      "gridPos": { "h": 9, "w": 12, "x": 12, "y": 1 },
      "id": 2,
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum by (le, status) (rate(http_server_requests_seconds_bucket{job=\"$job\", instance=\"$instance\"}[5m])))",
          "legendFormat": "p95 {{status}}",
          "refId": "A"
        }
      ],
      "title": "HTTP latency p95 by status (application)",
      "type": "timeseries"
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "reqps" }, "overrides": [] },
      "gridPos": { "h": 8, "w": 24, "x": 0, "y": 10 },
      "id": 3,
      "targets": [
        {
          "expr": "sum by (method, uri) (rate(http_server_requests_seconds_count{job=\"$job\", instance=\"$instance\", status=~\"5..\"}[5m]))",
          "legendFormat": "{{method}} {{uri}}",
          "refId": "A"
        }
      ],
      "title": "5xx errors by route (application)",
      "type": "timeseries"
    },
    {
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 18 },
      "id": 11,
      "title": "Nginx metrics reverse proxy (stub_status + exporter)",
      "type": "row"
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "short" }, "overrides": [] },
      "gridPos": { "h": 8, "w": 8, "x": 0, "y": 19 },
      "id": 4,
      "targets": [
        {
          "expr": "nginx_connections_active{job=\"nginx\", instance=\"$nginx_instance\"}",
          "legendFormat": "active",
          "refId": "A"
        },
        {
          "expr": "nginx_connections_reading{job=\"nginx\", instance=\"$nginx_instance\"}",
          "legendFormat": "reading",
          "refId": "B"
        },
        {
          "expr": "nginx_connections_writing{job=\"nginx\", instance=\"$nginx_instance\"}",
          "legendFormat": "writing",
          "refId": "C"
        },
        {
          "expr": "nginx_connections_waiting{job=\"nginx\", instance=\"$nginx_instance\"}",
          "legendFormat": "waiting",
          "refId": "D"
        }
      ],
      "title": "Nginx active connections",
      "type": "timeseries"
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "reqps" }, "overrides": [] },
      "gridPos": { "h": 8, "w": 8, "x": 8, "y": 19 },
      "id": 5,
      "targets": [
        {
          "expr": "rate(nginx_http_requests_total{job=\"nginx\", instance=\"$nginx_instance\"}[5m])",
