global:
  scrape_interval: {{ prometheus_scrape_interval | default('15s') }}
  evaluation_interval: {{ prometheus_evaluation_interval | default('15s') }}

rule_files:
  - /etc/prometheus/alerts.yml

scrape_configs:
{% for job in prometheus_scrape_jobs %}
  - job_name: {{ job.name }}
    metrics_path: {{ job.metrics_path | default('/metrics') }}
    scheme: {{ job.scheme | default('http') }}
{% if job.basic_auth | default(false) %}
    basic_auth:
      username: {{ metrics_basic_auth_user }}
      password: {{ vault_metrics_basic_auth_password }}
{% endif %}
    static_configs:
      - targets:
{% for target in job.targets %}
          - {{ target }}
{% endfor %}
{% endfor %}
