SPRING_PROFILES_ACTIVE=prod
SPRING_DATASOURCE_URL=jdbc:postgresql://{{ db_host }}:{{ db_port }}/{{ db_name }}?sslmode=require
SPRING_DATASOURCE_USERNAME={{ db_user }}
SPRING_DATASOURCE_PASSWORD={{ db_password }}

STORAGE_S3_BUCKET={{ spaces_bucket }}
STORAGE_S3_REGION={{ spaces_region }}
STORAGE_S3_ENDPOINT={{ spaces_endpoint }}
STORAGE_S3_ACCESSKEY={{ spaces_access_key }}
STORAGE_S3_SECRETKEY={{ spaces_secret_key }}
STORAGE_S3_CDNURL=

MANAGEMENT_SERVER_PORT=9090
JAVA_OPTS=-Xms256m -Xmx512m -XX:+UseContainerSupport

DOCKER_IMAGE={{ docker_image }}
