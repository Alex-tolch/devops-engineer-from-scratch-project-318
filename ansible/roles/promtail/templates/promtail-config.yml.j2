server:
  http_listen_port: 9080
  grpc_listen_port: 0
  log_level: info

positions:
  filename: {{ promtail_positions_file }}

clients:
  - url: {{ promtail_loki_push_url }}
{% if vault_loki_push_username | default('') | length > 0 %}
    basic_auth:
      username: {{ vault_loki_push_username }}
      password: {{ vault_loki_push_password }}
{% endif %}
    external_labels:
      cluster: bulletins
      env: {{ promtail_env }}

scrape_configs:
  - job_name: docker
    docker_sd_configs:
      - host: unix:///var/run/docker.sock
        refresh_interval: 15s
    relabel_configs:
      - source_labels: [__meta_docker_container_name]
        regex: "/(.*)"
        target_label: container
      - source_labels: [__meta_docker_container_log_stream]
        target_label: stream
      - target_label: job
        replacement: {{ promtail_job_app }}
      - target_label: app
        replacement: {{ promtail_app_name }}
      - target_label: env
        replacement: {{ promtail_env }}
      - target_label: host
        replacement: {{ promtail_host_label }}
    pipeline_stages:
      - json:
          expressions:
            level: level
            logger: logger_name
            app: app
            environment: environment
      - labels:
          level:
          app:
          environment:

  - job_name: nginx-metrics
    static_configs:
      - targets:
          - localhost
        labels:
          job: {{ promtail_job_nginx }}
          app: {{ promtail_app_name }}
          env: {{ promtail_env }}
          host: {{ promtail_host_label }}
          __path__: {{ promtail_nginx_access_log }}
    pipeline_stages:
      - json:
          expressions:
            status: status
            request_time: request_time
            remote_addr: remote_addr
            request_method: request_method
            request_uri: request_uri
      - labels:
          status:
          remote_addr:
          request_method:
